# Dossier de la base locale JSON et des sauvegardes (défaut : ./data)
PORKONIA_DATA_DIR=
# Racine des médias « locaux » (défaut : ./medias-locales). Lecture seule.
PORKONIA_MEDIA_ROOT=
# Mot de passe d'accès (HTTP Basic). Vide = aucun contrôle : NE PAS exposer l'app sur Internet dans ce cas.
PORKONIA_ADMIN_PASSWORD=
# 1 = démarrer avec une base vide au lieu des données de démonstration
PORKONIA_EMPTY_DB=

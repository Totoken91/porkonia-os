# Dossier de la base locale JSON et des sauvegardes (défaut : ./data)
PORKONIA_DATA_DIR=
# Racine des médias « locaux » (défaut : ./medias-locales). Lecture seule.
PORKONIA_MEDIA_ROOT=
# Mot de passe d'accès (HTTP Basic). Vide = aucun contrôle : NE PAS exposer l'app sur Internet dans ce cas.
PORKONIA_ADMIN_PASSWORD=
# 1 = initialiser une base neuve avec les données de DÉMONSTRATION (utilisé par npm run dev:demo)
PORKONIA_DEMO=
# Dossier des extractions Porkopédia (défaut : ./imports)
PORKONIA_IMPORTS_DIR=
# Origine autorisée (CORS) pour l'API publique en lecture seule
PORKONIA_PUBLIC_CORS_ORIGIN=

{
  "name": "porkonia-os",
  "version": "0.1.0",
  "private": true,
  "description": "PORKONIA OS — Édition Administrative 2005. Centre de commande éditorial de l'univers de Porkonia.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node scripts/backup.mjs",
    "media:backup": "tsx scripts/media-backup.mts",
    "porkopedia:snapshot": "node scripts/porkopedia-snapshot.mjs",
    "test:e2e": "node tests/e2e/parcours.mjs",
    "porkopedia:extract": "node scripts/porkopedia-extract.mjs",
    "backup:verify": "tsx scripts/restore.mts verify",
    "restore": "tsx scripts/restore.mts restore",
    "dev:demo": "PORKONIA_DEMO=1 PORKONIA_DATA_DIR=./data-demo next dev -p 3001",
    "import:report": "tsx scripts/import-report.mts",
    "test:e2e:import": "node tests/e2e/import.mjs",
    "media:verify": "tsx scripts/media-backup.mts --verify",
    "publication:simulate": "tsx scripts/publication-simulate.mts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}

{
  "name": "porkos",
  "version": "0.1.0",
  "private": true,
  "description": "PorkOS — le système d'exploitation officiel de la République de Porkonia. Démo jouable dans le navigateur.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "npx serve out -l 3000",
